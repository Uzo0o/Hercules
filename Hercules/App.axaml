<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hercules.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge the SVG icons dictionary -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hercules/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Font -->
            <FontFamily x:Key="Poppins">avares://Hercules/Assets/Fonts/#Poppins</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Hercules/Styles/AppDefaultStyles.axaml" />
    </Application.Styles>
</Application>