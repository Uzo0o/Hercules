<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,24">
            <TextBlock Grid.Column="0" Classes="PageTitle" Text="Data Mapping Workspace" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="BtnSecondary" Content="Refresh vMix Sources" Click="RefreshVmix_Click" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Classes="BtnPrimary" Content="+ Add Connection" Click="AddRow_Click"/>
        </Grid>

        <!-- Row 1: FIBA Connection Card -->
        <Border Grid.Row="1" Classes="Card" Margin="0,0,0,24">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *">
                <TextBlock Grid.Column="0" Classes="Label" Text="FIBA LiveStats IP" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Classes="FlatInput" Text="{Binding FibaIpAddress}" Width="140" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" Classes="Label" Text="Port" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Classes="FlatInput" Text="{Binding FibaPort}" Width="80" Margin="0,0,20,0"/>

                <Button Grid.Column="4"
                        x:Name="FibaConnectBtn"
                        Classes="BtnGreen"
                        Content="Connect to FIBA"
                        Click="ToggleFiba_Click"
                        Margin="0,0,20,0"/>

                <Border Grid.Column="5" x:Name="FibaStatusPill" Classes="StatusPill" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding FibaStatus}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Mapping Rows -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding MappingRows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="Row">
                            <Grid RowDefinitions="Auto, Auto" RowSpacing="10">

                                <!-- Line 1: optional Prefix + FIBA Stat + optional Suffix -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                    <TextBox Grid.Column="0" Classes="FlatInput" Width="60" Margin="0,0,8,0"
                                             Watermark="Prefix" Text="{Binding Prefix}"/>

                                    <ComboBox Grid.Column="1" Classes="FlatDropdown" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableFibaStats}"
                                              SelectedItem="{Binding SelectedFibaStat}"
                                              PlaceholderText="Select FIBA Stat...">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBox Grid.Column="2" Classes="FlatInput" Width="60" Margin="8,0,0,0"
                                             Watermark="Suffix" Text="{Binding Suffix}"/>
                                </Grid>

                                <!-- Line 2: Target vMix Graphic + Field + Remove -->
                                <Grid Grid.Row="1" ColumnDefinitions="*, *, Auto">
                                    <ComboBox Grid.Column="0" Classes="FlatDropdown" Margin="0,0,12,0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableVmixInputs}"
                                              SelectedItem="{Binding SelectedInput}"
                                              PlaceholderText="Target vMix Graphic...">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ComboBox Grid.Column="1" Classes="FlatDropdown" Margin="0,0,12,0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableFields}"
                                              SelectedItem="{Binding SelectedField}"
                                              PlaceholderText="Target Field...">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="2" Classes="BtnClose" Click="RemoveRow_Click" ToolTip.Tip="Remove connection">
                                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Width="14" Height="14"/>
                                    </Button>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
