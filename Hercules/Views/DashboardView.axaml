<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Row 0: Main Header & Add Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" Text="Data Mapping Workspace" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh vMix Sources" Click="RefreshVmix_Click" Background="#2D2D30" Foreground="White" Padding="15,8" CornerRadius="4" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="+ Add Connection" Click="AddRow_Click" Background="#2D2D30" Foreground="White" Padding="15,8" CornerRadius="4"/>
        </Grid>

        <!-- Row 1: FIBA Connection Bar -->
        <Border Grid.Row="1" Background="#252525" CornerRadius="6" Padding="15" Margin="0,0,0,20">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *">
                <TextBlock Grid.Column="0" Text="FIBA LiveStats IP:" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding FibaIpAddress}" Width="130" Margin="0,0,15,0"/>
                
                <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Text="{Binding FibaPort}" Width="70" Margin="0,0,20,0"/>
                
                <Button Grid.Column="4" 
                        Content="Connect to FIBA" 
                        Click="ToggleFiba_Click" 
                        Background="#254A25" 
                        Foreground="White" 
                        Padding="20,8" 
                        CornerRadius="4"/>
                        <!-- We will set the text of this button in the code-behind dynamically for simplicity -->

                <TextBlock Grid.Column="5" Text="{Binding FibaStatus}" VerticalAlignment="Center" Foreground="#888888" Margin="20,0,0,0" FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Row 2: The Dynamic Table (Exactly as you had it before) -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding MappingRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Each Row is a Grid -->
                        <Grid ColumnDefinitions="*, *, *, Auto" Margin="0,0,0,10">
                            
                            <ComboBox Grid.Column="0" Classes="FlatDropdown" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).FibaStatDefinitions}"
                                      SelectedItem="{Binding SelectedFibaStat}"
                                      PlaceholderText="Select FIBA Stat">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox Grid.Column="1" Classes="FlatDropdown" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).MasterVmixInputs}"
                                      SelectedItem="{Binding SelectedInput}"
                                      PlaceholderText="Target vMix Graphic">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox Grid.Column="2" Classes="FlatDropdown" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableFields}"
                                      SelectedItem="{Binding SelectedField}"
                                      PlaceholderText="Target Field">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <Button Grid.Column="3" Content="✕" Click="RemoveRow_Click" Background="#4A2525" Foreground="White" Width="35" HorizontalContentAlignment="Center"/>
                            
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>