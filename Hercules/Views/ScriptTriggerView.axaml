<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.ScriptTriggerView"
             x:DataType="vm:ScriptTriggerViewModel">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
            <TextBlock Grid.Column="0" Classes="PageTitle" Text="Script Triggers" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="BtnPrimary" Content="+ Add Trigger" Click="AddRow_Click"/>
        </Grid>

        <!-- Row 1: Explanation card -->
        <Border Grid.Row="1" Classes="Card" Margin="0,0,0,24">
            <TextBlock Classes="Label" TextWrapping="Wrap"
                       Text="Each row fires a vMix Script (Settings &#8594; Scripting) whenever the selected FIBA event happens. Uses the same FIBA connection as the Dashboard tab - connect there first."/>
        </Border>

        <!-- Row 2: Trigger Rows -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding TriggerRows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="Row">
                            <Grid ColumnDefinitions="*, *, Auto">

                                <TextBox Grid.Column="0" Classes="FlatInput" Margin="0,0,12,0"
                                         HorizontalAlignment="Stretch"
                                         Watermark="Script name, e.g. 1_Home_Score.TXT"
                                         Text="{Binding ScriptName}"/>

                                <ComboBox Grid.Column="1" Classes="FlatDropdown" Margin="0,0,12,0" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableTriggers}"
                                          SelectedItem="{Binding SelectedTrigger}"
                                          PlaceholderText="Trigger when...">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="2" Classes="BtnClose" Click="RemoveRow_Click" ToolTip.Tip="Remove trigger">
                                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                              Width="14" Height="14"/>
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
