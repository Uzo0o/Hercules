<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.MappingView"
             x:DataType="vm:MappingViewModel">

    <Design.DataContext>
        <vm:MappingViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*, Auto">
            <TextBlock Grid.Column="0" Classes="PageTitle" Text="vMix Source Discovery" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="BtnPrimary" Content="Refresh vMix Sources" Click="Refresh_Click"/>
        </Grid>

        <!-- The Cascading Dropdowns -->
        <Border Classes="Card">
            <Grid ColumnDefinitions="Auto, *, Auto, *" ColumnSpacing="16">

                <TextBlock Grid.Column="0" Classes="Label" Text="Target Graphic:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          Classes="FlatDropdown"
                          ItemsSource="{Binding AvailableInputs}"
                          SelectedItem="{Binding SelectedInput}"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,20,0"
                          PlaceholderText="Select a graphic...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="2" Classes="Label" Text="Target Field:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3"
                          Classes="FlatDropdown"
                          ItemsSource="{Binding AvailableFields}"
                          SelectedItem="{Binding SelectedField}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Select a field...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>