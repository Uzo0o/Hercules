<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.MappingView"
             x:DataType="vm:MappingViewModel">
    
    <Design.DataContext>
        <vm:MappingViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20" Margin="10">
        <TextBlock Text="vMix Source Discovery" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
        
        <!-- Refresh Button -->
        <Button Content="Refresh vMix Sources" 
                Click="Refresh_Click"
                Background="#2D2D30" 
                Foreground="White"
                Padding="15,8"
                CornerRadius="4"/>

        <!-- The Cascading Dropdowns -->
        <Grid ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto" Margin="0,20,0,0">
            
            <!-- Dropdown 1: Select the Graphic -->
            <TextBlock Grid.Column="0" Text="Target Graphic:" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#CCCCCC"/>
            <ComboBox Grid.Column="1" 
                      Classes="FlatDropdown"
                      ItemsSource="{Binding AvailableInputs}" 
                      SelectedItem="{Binding SelectedInput}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,30,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Dropdown 2: Select the Field (Updates automatically) -->
            <TextBlock Grid.Column="2" Text="Target Field:" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#CCCCCC"/>
            <ComboBox Grid.Column="3" 
                      Classes="FlatDropdown"
                      ItemsSource="{Binding AvailableFields}" 
                      SelectedItem="{Binding SelectedField}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        
    </StackPanel>
</UserControl>
