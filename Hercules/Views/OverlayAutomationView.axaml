<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.OverlayAutomationView"
             x:DataType="vm:OverlayAutomationViewModel">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,24">
            <TextBlock Grid.Column="0" Classes="PageTitle" Text="Overlay Automations" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="BtnSecondary" Content="Refresh vMix Sources" Click="RefreshVmix_Click" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Classes="BtnPrimary" Content="+ Add Automation" Click="AddRow_Click"/>
        </Grid>

        <!-- Row 1: Explanation card -->
        <Border Grid.Row="1" Classes="Card" Margin="0,0,0,24">
            <TextBlock Classes="Label" TextWrapping="Wrap"
                       Text="Each automation shows a chosen vMix input on one of vMix's 4 overlay channels whenever the selected FIBA event happens - e.g. flash a '3 POINTS!' graphic on Overlay 1 whenever Home makes a 3. Uses the same FIBA connection as the Dashboard tab - connect there first."/>
        </Border>

        <!-- Row 2: Automation Rows -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="Card">
                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*" RowSpacing="12">

                                <!-- Line 1: Trigger + Graphic -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, *">
                                    <ComboBox Grid.Column="0" Classes="FlatDropdown" Margin="0,0,12,0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableTriggers}"
                                              SelectedItem="{Binding SelectedTrigger}"
                                              PlaceholderText="Trigger when...">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ComboBox Grid.Column="1" Classes="FlatDropdown" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableInputs}"
                                              SelectedItem="{Binding SelectedInput}"
                                              PlaceholderText="Show vMix Input...">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- Line 2: Overlay channel + auto-hide + remove -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
                                    <TextBlock Grid.Column="0" Classes="Label" Text="Overlay Channel" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" Classes="FlatDropdown" Width="80" Margin="0,0,24,0"
                                              ItemsSource="{x:Static vm:OverlayAutomationRowViewModel.OverlayChannels}"
                                              SelectedItem="{Binding OverlayChannel}"/>

                                    <CheckBox Grid.Column="2" Content="Auto-hide after" IsChecked="{Binding AutoHideEnabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="3" Classes="FlatInput" Width="80" Text="{Binding AutoHideMs}"
                                             IsEnabled="{Binding AutoHideEnabled}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Classes="Label" Text="ms" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                    <Button Grid.Column="5" Classes="BtnClose" Click="RemoveRow_Click" ToolTip.Tip="Remove automation">
                                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Width="14" Height="14"/>
                                    </Button>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
