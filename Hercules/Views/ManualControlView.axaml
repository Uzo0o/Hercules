<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.ManualControlView"
             x:DataType="vm:ManualControlViewModel">

    <Design.DataContext>
        <vm:ManualControlViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20" Margin="10">
        <Grid ColumnDefinitions="*, Auto">
            <TextBlock Grid.Column="0" Text="Manual Override &amp; Testing" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh Sources" Click="Refresh_Click" Background="#2D2D30" Foreground="White" Padding="15,8"/>
        </Grid>

        <!-- Selection Grid -->
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Graphic:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="1" Grid.Column="0" Classes="FlatDropdown" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableInputs}" SelectedItem="{Binding SelectedInput}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Target Field:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Classes="FlatDropdown" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding SelectedField}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Control Pad -->
        <Border Background="#252525" CornerRadius="8" Padding="20">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <Button Grid.Column="0" Content="-1" Click="Minus_Click" FontSize="24" Background="#4A2525" Foreground="White" Width="60" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                
                <TextBox Grid.Column="1" Text="{Binding CurrentValue, Mode=TwoWay}" FontSize="24" TextAlignment="Center" Margin="20,0" VerticalContentAlignment="Center"/>
                
                <Button Grid.Column="2" Content="+1" Click="Plus_Click" FontSize="24" Background="#254A25" Foreground="White" Width="60" Height="60" Margin="0,0,20,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                
                <Button Grid.Column="3" Content="Push" Click="Push_Click" FontSize="20" Background="#2D2D30" Foreground="White" Width="100" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>