<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hercules.ViewModels"
             x:Class="Hercules.Views.ManualControlView"
             x:DataType="vm:ManualControlViewModel">

    <Design.DataContext>
        <vm:ManualControlViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*, Auto">
            <TextBlock Grid.Column="0" Classes="PageTitle" Text="Manual Override &amp; Testing" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="BtnSecondary" Content="Refresh Sources" Click="Refresh_Click"/>
        </Grid>

        <!-- Selection Card -->
        <Border Classes="Card">
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="20">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="Target Graphic" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="1" Grid.Column="0" Classes="FlatDropdown" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailableInputs}" SelectedItem="{Binding SelectedInput}"
                          PlaceholderText="Target vMix Graphic...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="1" Classes="Label" Text="Target Field" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Classes="FlatDropdown" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding SelectedField}"
                          PlaceholderText="Target Field...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Control Pad -->
        <Border Classes="Card">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalAlignment="Center">
                <Button Grid.Column="0" Classes="BtnClose" Width="60" Height="60" Click="Minus_Click">
                    <TextBlock Text="-1" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentDanger}"/>
                </Button>

                <TextBox Grid.Column="1" Classes="FlatInput" Text="{Binding CurrentValue, Mode=TwoWay}"
                         FontSize="24" TextAlignment="Center" Margin="20,0" VerticalContentAlignment="Center"/>

                <Button Grid.Column="2" Classes="BtnGreen" Content="+1" FontSize="22" Width="60" Height="60"
                        Margin="0,0,20,0" Click="Plus_Click"/>

                <Button Grid.Column="3" Classes="BtnPrimary" Content="Push" FontSize="16" Width="100" Height="60"
                        Click="Push_Click"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>